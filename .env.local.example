# ---- Supabase ----
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=

# Service role key, used only by server-side admin operations.
# Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Dashboard -> Connect -> transaction pooler (port 6543).
# Used by the app and by scripts/apply-schema.ts.
DATABASE_URL=

# Optional: direct Postgres connection (port 5432). Only a few one-off
# helper scripts prefer this when available.
DIRECT_URL=

# Optional: public origin used for canonical URLs, robots and sitemap.
# Example: https://clubhub.example.com
NEXT_PUBLIC_SITE_URL=
